##################################################
# PLAYERBOT CONFIGURATION FILE                   #
##################################################
[playerbots]
ConfVersion=2024050400

###################################################################################################
# SECTION INDEX
#   GENERAL SETTINGS
#   PLAYERBOT SETTINGS
#       GENERAL
#       CHAT
#       TIMERS
#       DISTANCES
#       THRESHOLDS
#       COMBAT
#       SPELLS
#   PLAYERBOT RNDBOT SPECIFIC SETTINGS
#       GENERAL
#       LEVELS
#       QUESTS
#       STRATEGIES
#       BATTLEGROUNDS & ARENAS & PVP
#       INTERVALS
#   PREMADE SPECS
#       WARRIOR
#       PALADIN
#       HUNTER
#       ROGUE
#       PRIEST
#       DEATHKNIGHT
#       SHAMAN
#       MAGE
#       WARLOCK
#       DRUID
#   PLAYERBOT SYSTEM SETTINGS
#       DATABASE & CONNECTIONS
#       DEBUG SWITCHES
#   Deprecated (temporary)
###################################################################################################

###################################
#                                 #
# GENERAL SETTINGS                #
#                                 #
###################################

####################################################################################################

# Enable or disable AI Playerbot
AiPlayerbot.Enabled = 1

# Enable random bot system
AiPlayerbot.RandomBotAutologin = 1

# Random bot account
# Please ensure that RandomBotAccountCount is greater than (MaxRandomBots / 10 + AddClassAccountPoolSize)
AiPlayerbot.RandomBotAccountCount = 200

# Random bot count
AiPlayerbot.MinRandomBots = 50
AiPlayerbot.MaxRandomBots = 50

###################################
#                                 #
# PLAYERBOT SETTINGS              #
#                                 #
###################################

####################################################################################################
# GENERAL
#
#

# Maximum number of bots added by one account
AiPlayerbot.MaxAddedBots = 40

# Maximum number of bots per class added by one account
AiPlayerbot.MaxAddedBotsPerClass = 40

#
#
#
####################################################################################################

####################################################################################################
# CHAT
#
#

# Whisper a bot, or use party/raid chat, to command it. Bots take commands from their master,
# from GMs and from players in their group. Whisper "help" to a bot for the command list.

# Only treat messages starting with this prefix as commands (e.g. "!" for "!follow")
# Default: "" (every message is a command)
AiPlayerbot.CommandPrefix = ""

# Separates several commands in one message (e.g. "follow\\stats")
# Default: "\\"
AiPlayerbot.CommandSeparator = "\\"

#
#
#
####################################################################################################

####################################################################################################
# TIMERS
#
#

# Max AI iterations per tick
AiPlayerbot.IterationsPerTick = 10

# Delay between two short-time spells cast
AiPlayerbot.GlobalCooldown = 500

# Max wait time when moving
AiPlayerbot.MaxWaitForMove = 5000

# Disables use of MoveSplinePath for bot movement, will result in more erratic bot movement but means stun/snare/root/etc
# will work on bots (they wont reliably work when MoveSplinePath is enabled, though slowing effects still work ok)
# Default: 0 - MoveSplinePath enabled
#          1 - MoveSplinePath disabled in BG/Arena only
#          2 - MoveSplinePath disabled everywhere
AiPlayerbot.DisableMoveSplinePath = 0

# Max search time for movement (higher for better movement on slopes)
# default: 3
AiPlayerbot.MaxMovementSearchTime = 3

# Action expiration time
AiPlayerbot.ExpireActionTime = 5000

# Max dispel auras duration
AiPlayerbot.DispelAuraDuration = 700

# Delay between two bot actions
AiPlayerbot.ReactDelay = 100

# Dynamically adjust react delay for bots in different status to reduce server lags
AiPlayerbot.DynamicReactDelay = 1

# Inactivity delay
AiPlayerbot.PassiveDelay = 10000

# Minimum delay between repeating actions (chat messages, emotes etc)
AiPlayerbot.RepeatDelay = 2000

# Delay timers
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
# ReturnDelay has a minimum value of 2000 - lower values will cause a crash!
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

#
#
#
####################################################################################################

####################################################################################################
# DISTANCES
#
#

AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 75.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 5.0
AiPlayerbot.ReactDistance = 150.0
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 15.0
AiPlayerbot.FleeDistance = 5.0
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 0.75
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.45
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.AggroDistance = 22

#
#
#
####################################################################################################

####################################################################################################
#THRESHOLDS
#
#

# Health/Mana levels
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

#
#
#
####################################################################################################

####################################################################################################
# COMBAT
#
#

# Enable auto avoid aoe (experimental)
# Default: 1 (enable)
AiPlayerbot.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810

# Enable healer bot save mana
# Default: 1 (enable)
AiPlayerbot.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
AiPlayerbot.SaveManaThreshold = 60

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# ID of spell to open lootable chests
AiPlayerbot.OpenGoSpell = 6477

#
#
#
###################################################################################################

####################################################################################################
# LOOT AND GEAR
#
#

# Bots equip items in their bags that are upgrades
# Default: 1 (enabled)
AiPlayerbot.AutoEquipUpgradeLoot = 1

# Threshold for equipping upgrades
# Default: 1.1 (equip when the new item scores 1.1 times the equipped one)
AiPlayerbot.EquipUpgradeThreshold = 1.1

# Bots keep looting when the group loot method is free for all
# Default: 0 (disabled)
AiPlayerbot.FreeMethodLoot = 0

# Roll bots make on items they need (0 = pass, 1 = greed, 2 = need)
# Default: 1 (greed)
AiPlayerbot.LootNeedRollLevel = 1

# Bots roll greed on items they don't need. If disabled they pass instead
# Default: 0 (disabled)
AiPlayerbot.LootGreedRollLevel = 0

# Bots roll on recipes: need on recipes they can learn, greed on bind-on-equip recipes they can't
# Default: 0 (disabled)
AiPlayerbot.LootRollRecipe = 0

# Bots with enchanting roll disenchant instead of greed when they can
# Default: 0 (disabled)
AiPlayerbot.LootRollDisenchant = 0

# Cheats for all bots, separated by commas
# "food": eat and drink without food or water in the bags
# Default: "food"
AiPlayerbot.BotCheats = "food"

#
#
#
###################################################################################################

#######################################
#                                     #
# PLAYERBOT RNDBOT SPECIFIC SETTINGS  #
#                                     #
#######################################

####################################################################################################
# GENERAL
#
#

# Accounts to create for random bots
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 90

#
#
#
####################################################################################################

####################################################################################################
# LEVELS
#
#

# Disable random levels for randombots
# Every bots started on the specified level and level up by killing mobs.
AiPlayerbot.DisableRandomLevels = 0

# Chance random bot has max level on first randomize (default 0.15)
AiPlayerbot.RandomBotMaxLevelChance = 0.15

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# Random bots that aren't following anyone wander on their own: they travel to farming spots
# and grind, visit nearby NPCs and innkeepers, and rest. When disabled they only move randomly.
# Default: 1 (enabled)
AiPlayerbot.EnableNewRpgStrategy = 1

#
#
#
####################################################################################################

####################################################################################################
# STRATEGIES
#
#

# Random bot default strategies (applied after defaults)
AiPlayerbot.RandomBotCombatStrategies = "+dps,+dps assist,-threat"
# AiPlayerbot.RandomBotNonCombatStrategies = "+grind,+loot,+rpg,+custom::say"
AiPlayerbot.RandomBotNonCombatStrategies = ""
AiPlayerbot.CombatStrategies = ""
AiPlayerbot.NonCombatStrategies = ""

#
#
#
####################################################################################################

####################################################################################################
# BATTLEGROUNDS & ARENAS & PVP
#
#

# PvP Restricted Zones (bots don't pvp)
AiPlayerbot.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,139"

# PvP Restricted Areas (bots don't pvp)
AiPlayerbot.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312"

#
#
#
####################################################################################################

####################################################################################################
# INTERVALS
#
#

# All In seconds
AiPlayerbot.RandomBotUpdateInterval = 20
AiPlayerbot.RandomBotCountChangeMinInterval = 1800
AiPlayerbot.RandomBotCountChangeMaxInterval = 7200
AiPlayerbot.MinRandomBotInWorldTime = 3600
AiPlayerbot.MaxRandomBotInWorldTime = 1209600
AiPlayerbot.MinRandomBotRandomizeTime = 7200
AiPlayerbot.MaxRandomBotRandomizeTime = 1209600
AiPlayerbot.RandomBotsPerInterval = 60
AiPlayerbot.MinRandomBotTeleportInterval = 3600
AiPlayerbot.MaxRandomBotTeleportInterval = 18000

#
#
#
####################################################################################################

###################################
#                                 #
# PREMADE SPECS                   #
#                                 #
###################################

# Talents and major glyphs random bots take, per class and specialization. Without a setting bots use
# the built-in templates (shown below, commented out); minor glyphs are random.
#
# AiPlayerbot.PremadeSpecLink.<class>.<specIndex> = <one digit per tier>
#     The column of the talent to take in each tier, 0 to 2 from left to right as in the talent
#     window, "." for a random one. "011211" takes the first talent in tier 1 (level 15), the second
#     in tier 2, and so on.
# AiPlayerbot.PremadeSpecGlyph.<class>.<specIndex> = <glyph name>,<glyph name>,...
#     Major glyphs, without "Glyph of": "Victory Rush,Unending Rage".
#
# Classes: 1 warrior, 2 paladin, 3 hunter, 4 rogue, 5 priest, 6 death knight, 7 shaman, 8 mage,
# 9 warlock, 10 monk, 11 druid. Specialization indexes in talent window order, for example warrior
# 0 arms, 1 fury, 2 protection; druid 0 balance, 1 feral, 2 guardian, 3 restoration.
#
# The templates favor passive talents and glyphs, and talents that replace a spell, since bots only
# cast what their class strategies know.
#
# AiPlayerbot.PremadeSpecLink.1.0 = 011211
# AiPlayerbot.PremadeSpecLink.1.1 = 011211
# AiPlayerbot.PremadeSpecLink.1.2 = 011110
# AiPlayerbot.PremadeSpecLink.2.0 = 201120
# AiPlayerbot.PremadeSpecLink.2.1 = 201122
# AiPlayerbot.PremadeSpecLink.2.2 = 200122
# AiPlayerbot.PremadeSpecLink.3.0 = 022210
# AiPlayerbot.PremadeSpecLink.4.0 = 110002
# AiPlayerbot.PremadeSpecLink.5.0 = 001222
# AiPlayerbot.PremadeSpecLink.5.1 = 000222
# AiPlayerbot.PremadeSpecLink.5.2 = 001202
# AiPlayerbot.PremadeSpecLink.6.0 = 021011
# AiPlayerbot.PremadeSpecLink.7.0 = 001221
# AiPlayerbot.PremadeSpecLink.7.1 = 001220
# AiPlayerbot.PremadeSpecLink.7.2 = 001201
# AiPlayerbot.PremadeSpecLink.8.0 = 112100
# AiPlayerbot.PremadeSpecLink.8.1 = 112110
# AiPlayerbot.PremadeSpecLink.8.2 = 112120
# AiPlayerbot.PremadeSpecLink.9.0 = 110111
# AiPlayerbot.PremadeSpecLink.10.0 = 001201
# AiPlayerbot.PremadeSpecLink.11.0 = 002021
#
# Built-in talent templates not listed are the same as the class's first one: hunter, rogue, death
# knight, warlock, monk and druid specializations share one.
#
# Major glyphs: the PvE recommendations of Method's Mists of Pandaria Classic class guides (raiding,
# single target), the first three where a guide lists more. Where a guide lists only two, the third is
# its first listed alternative: Cloak of Shadows for combat and subtlety rogues, Healing Stream Totem for
# elemental, Feral Spirit for enhancement, Chaining for restoration shamans, Eternal Resolve for
# destruction warlocks. These are also the built-in defaults.

AiPlayerbot.PremadeSpecGlyph.1.0 = Unending Rage,Colossus Smash,Bull Rush
AiPlayerbot.PremadeSpecGlyph.1.1 = Unending Rage,Colossus Smash,Bull Rush
AiPlayerbot.PremadeSpecGlyph.1.2 = Heavy Repercussions,Hold the Line,Unending Rage
AiPlayerbot.PremadeSpecGlyph.2.0 = Hand of Sacrifice,Protector of the Innocent,Divinity
AiPlayerbot.PremadeSpecGlyph.2.1 = Focused Shield,the Alabaster Shield,Final Wrath
AiPlayerbot.PremadeSpecGlyph.2.2 = Hand of Sacrifice,Templar's Verdict,Inquisition
AiPlayerbot.PremadeSpecGlyph.3.0 = Deterrence,Animal Bond,Disengage
AiPlayerbot.PremadeSpecGlyph.3.1 = Aimed Shot,Deterrence,Animal Bond
AiPlayerbot.PremadeSpecGlyph.3.2 = Deterrence,Animal Bond,Disengage
AiPlayerbot.PremadeSpecGlyph.4.0 = Vendetta,Feint,Redirect
AiPlayerbot.PremadeSpecGlyph.4.1 = Feint,Redirect,Cloak of Shadows
AiPlayerbot.PremadeSpecGlyph.4.2 = Feint,Redirect,Cloak of Shadows
AiPlayerbot.PremadeSpecGlyph.5.0 = Penance,Fade,Smite
AiPlayerbot.PremadeSpecGlyph.5.1 = Fade,Renew,Circle of Healing
AiPlayerbot.PremadeSpecGlyph.5.2 = Vampiric Embrace,Fade,Dispersion
AiPlayerbot.PremadeSpecGlyph.6.0 = Outbreak,Anti-Magic Shell,Regenerative Magic
AiPlayerbot.PremadeSpecGlyph.6.1 = Pestilence,Anti-Magic Shell,Loud Horn
AiPlayerbot.PremadeSpecGlyph.6.2 = Loud Horn,Anti-Magic Shell,Regenerative Magic
AiPlayerbot.PremadeSpecGlyph.7.0 = Lightning Shield,Flame Shock,Healing Stream Totem
AiPlayerbot.PremadeSpecGlyph.7.1 = Lightning Shield,Fire Nova,Feral Spirit
AiPlayerbot.PremadeSpecGlyph.7.2 = Telluric Currents,Healing Stream Totem,Chaining
AiPlayerbot.PremadeSpecGlyph.8.0 = Arcane Power,Evocation,Rapid Displacement
AiPlayerbot.PremadeSpecGlyph.8.1 = Rapid Displacement,Combustion,Inferno Blast
AiPlayerbot.PremadeSpecGlyph.8.2 = Icy Veins,Splitting Ice,Water Elemental
AiPlayerbot.PremadeSpecGlyph.9.0 = Unstable Affliction,Siphon Life,Healthstone
AiPlayerbot.PremadeSpecGlyph.9.1 = Imp Swarm,Siphon Life,Demon Training
AiPlayerbot.PremadeSpecGlyph.9.2 = Siphon Life,Healthstone,Eternal Resolve
AiPlayerbot.PremadeSpecGlyph.10.0 = Fortifying Brew,Touch of Death,Spinning Crane Kick
AiPlayerbot.PremadeSpecGlyph.10.1 = Spinning Crane Kick,Touch of Death,Touch of Karma
AiPlayerbot.PremadeSpecGlyph.10.2 = Renewing Mists,Zen Meditation,Touch of Death
AiPlayerbot.PremadeSpecGlyph.11.0 = Stampede,Stampeding Roar,Rebirth
AiPlayerbot.PremadeSpecGlyph.11.1 = Stampeding Roar,Savagery,Cat Form
AiPlayerbot.PremadeSpecGlyph.11.2 = Stampeding Roar,Rebirth,Maul
AiPlayerbot.PremadeSpecGlyph.11.3 = Efflorescence,Wild Growth,Rejuvenation

###################################
#                                 #
# PLAYERBOT SYSTEM SETTINGS       #
#                                 #
###################################

####################################################################################################
# DATABASE & CONNECTIONS
#
#

#    PlayerbotsDatabaseInfo
#        Description: Database connection settings for the playerbots server.
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Use named pipes on Windows
#                                                                 "enable-named-pipe" to [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (use Unix sockets on
#                                                                           Unix/Linux)
#        Default:     "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_playerbots"

#
#    PlayerbotsDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#                     MySQL server and their own thread on the MySQL server.
#        Default:     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#
#    PlayerbotsDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle.
#        Default:     1 - (PlayerbotDatabase.WorkerThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbot.Updates.EnableDatabases
#        Description: Determined if updates system work with playerbot database.
#
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Playerbots.Updates.EnableDatabases = 1

#
#
#
####################################################################################################

####################################################################################################
# DEBUG SWITCHES
#
#

AiPlayerbot.RandomChangeMultiplier = 1

# Tell which spell is avoiding (experimental)
# Default: 0 (disable)
AiPlayerbot.TellWhenAvoidAoe = 0

# Enables/Disables performance monitor
AiPlayerbot.PerfMonEnabled = 0

#
#
#
####################################################################################################

##############################################
# Deprecated (temporary)                     #
##############################################

# Log on all random bots on start
AiPlayerbot.RandomBotLoginAtStartup = 1
