AiPlayerbot.PremadeSpecName.6.0 = blood pve
AiPlayerbot.PremadeSpecName.6.1 = frost pve
AiPlayerbot.PremadeSpecName.6.2 = unholy pve
AiPlayerbot.PremadeSpecName.6.3 = double aura blood pve

#
