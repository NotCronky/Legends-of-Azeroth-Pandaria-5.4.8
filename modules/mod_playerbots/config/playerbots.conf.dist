# PREMADE SPECS                   #
#                                 #
###################################

# AiPlayerbot.PremadeSpecName.<class>.<specIndex> = <name>
# AiPlayerbot.PremadeSpecLink.<class>.<specIndex> = <talent id>,<talent id>,...
#     Talent IDs from Talent.dbc, one per tier in tier order. When no link is set for a spec,
#     bots pick a random talent in each unlocked tier.

###################################################################################################
